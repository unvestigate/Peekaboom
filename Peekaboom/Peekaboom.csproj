<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Peekaboom</RootNamespace>
    <AssemblyName>Peekaboom</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.*" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.*" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.*" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.*" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rendering\Shaders\*.hlsl">
      <LogicalName>Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peekaboom.Protocol\Peekaboom.Protocol.csproj" />
    <ProjectReference Include="..\Peekaboom.Model\Peekaboom.Model.csproj" />
  </ItemGroup>

</Project>

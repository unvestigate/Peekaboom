<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="using:Peekaboom.Docking"
             x:Class="Peekaboom.UI.PropertiesPanel"
             x:DataType="docking:PropertiesViewModel">

  <DockPanel>
    <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Margin="6,6,6,4" FontSize="12" FontWeight="SemiBold"
               Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />

    <ListBox x:Name="Rows" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Padding="0,2"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="2,1" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="docking:PropertyRow">
          <Grid ColumnDefinitions="2*,3*">
            <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="{Binding NameMargin}" Foreground="{Binding NameForeground}"
                       FontWeight="{Binding Weight}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{Binding ValueForeground}" FontSize="12"
                       FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>

</UserControl>

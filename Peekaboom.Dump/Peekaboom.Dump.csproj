<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Peekaboom.Dump</RootNamespace>
    <AssemblyName>Peekaboom.Dump</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peekaboom.Protocol\Peekaboom.Protocol.csproj" />
    <ProjectReference Include="..\Peekaboom.Model\Peekaboom.Model.csproj" />
  </ItemGroup>

</Project>
